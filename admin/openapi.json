{"openapi":"3.1.0","info":{"title":"Dating AI Chat","version":"0.1.0"},"paths":{"/api/profiles":{"post":{"tags":["profiles"],"summary":"Create Profile","operationId":"create_profile_api_profiles_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["profiles"],"summary":"List Profiles","operationId":"list_profiles_api_profiles_get","parameters":[{"name":"is_active","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Is Active"}},{"name":"gender","in":"query","required":false,"schema":{"anyOf":[{"enum":["female","male"],"type":"string"},{"type":"null"}],"title":"Gender"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/options":{"get":{"tags":["profiles"],"summary":"Get Options","operationId":"get_options_api_profiles_options_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/profiles/import":{"post":{"tags":["profiles"],"summary":"Import Profiles","description":"Create every persona in an uploaded JSON file, or none of them.\n\nThe body is the file's raw text. It is parsed here rather than by FastAPI so a\nfile the AI got slightly wrong reports the line and column to fix.","operationId":"import_profiles_api_profiles_import_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/profiles/import/prompt":{"get":{"tags":["profiles"],"summary":"Import Prompt","description":"The brief the admin pastes into an AI chat to get an importable file.\n\nBuilt from `ProfileImportIn`, so it always describes the format this server\naccepts today; adding a field without documenting it fails here loudly.","operationId":"import_prompt_api_profiles_import_prompt_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/profiles/{profile_id}":{"get":{"tags":["profiles"],"summary":"Get Profile","operationId":"get_profile_api_profiles__profile_id__get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"tags":["profiles"],"summary":"Update Profile","operationId":"update_profile_api_profiles__profile_id__put","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["profiles"],"summary":"Delete Profile","operationId":"delete_profile_api_profiles__profile_id__delete","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/experts":{"post":{"tags":["experts"],"summary":"Create Expert","operationId":"create_expert_api_experts_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExpertIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["experts"],"summary":"List Experts","operationId":"list_experts_api_experts_get","parameters":[{"name":"is_active","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Is Active"}},{"name":"gender","in":"query","required":false,"schema":{"anyOf":[{"enum":["female","male"],"type":"string"},{"type":"null"}],"title":"Gender"}},{"name":"category","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Category"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/experts/options":{"get":{"tags":["experts"],"summary":"Get Options","operationId":"get_options_api_experts_options_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/experts/import":{"post":{"tags":["experts"],"summary":"Import Experts","description":"Create every expert in an uploaded JSON file, or none of them.\n\nThe body is the file's raw text, parsed here so a file the AI got slightly\nwrong reports the line and column to fix.","operationId":"import_experts_api_experts_import_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/experts/import/prompt":{"get":{"tags":["experts"],"summary":"Import Prompt","description":"The brief the admin pastes into an AI chat to get an importable file.\n\nBuilt from `ExpertImportIn`, so it always describes the format this server\naccepts today; adding a field without documenting it fails here loudly.","operationId":"import_prompt_api_experts_import_prompt_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/experts/{expert_id}":{"get":{"tags":["experts"],"summary":"Get Expert","operationId":"get_expert_api_experts__expert_id__get","parameters":[{"name":"expert_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"tags":["experts"],"summary":"Update Expert","operationId":"update_expert_api_experts__expert_id__put","parameters":[{"name":"expert_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExpertIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["experts"],"summary":"Delete Expert","operationId":"delete_expert_api_experts__expert_id__delete","parameters":[{"name":"expert_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations":{"post":{"tags":["conversations"],"summary":"Create Conversation","description":"Start a chat. The returned `conversation_id` is all the caller needs to keep.","operationId":"create_conversation_api_conversations_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConversationIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["conversations"],"summary":"List Conversations","operationId":"list_conversations_api_conversations_get","parameters":[{"name":"external_user_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"External User Id"}},{"name":"profile_id","in":"query","required":false,"schema":{"anyOf":[{"$ref":"#/components/schemas/PydanticObjectId"},{"type":"null"}],"title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{conversation_id}/messages":{"post":{"tags":["conversations"],"summary":"Send Message","description":"Send the human's message(s), get the persona's reply.\n\nTwo request shapes. `message` is a single text. `messages` is a burst — the\nrun of texts he fired off before going quiet, batched by a frontend that\nwatched him stop typing. Each text becomes its own history row, and the whole\nburst gets ONE reply, exactly as if the texts had arrived one request each.\n\nThe persona answers the way a person texts: `messages` is one to a few short\nbubbles, each with the `delay_ms` to wait *before* showing it (the first one\nalready discounts the time we spent generating). Show a typing indicator,\nsleep the gap, render the bubble, repeat. `reply` is the same text joined\nwith newlines, for callers that only want the whole thing.\n\nUnbatched callers can still send as many requests in a row as he types — no\nneed to wait for the reply. A burst gets one reply between them, returned to\nwhichever request came last; the earlier ones come back with\n`superseded: true` and an empty `messages`, so rendering the array is always\nthe right thing to do.","operationId":"send_message_api_conversations__conversation_id__messages_post","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["conversations"],"summary":"Get Messages","description":"History, oldest -> newest. Pass `before` = the oldest id you have to page back.","operationId":"get_messages_api_conversations__conversation_id__messages_get","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50,"title":"Limit"}},{"name":"before","in":"query","required":false,"schema":{"anyOf":[{"$ref":"#/components/schemas/PydanticObjectId"},{"type":"null"}],"title":"Before"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{conversation_id}/opener":{"post":{"tags":["conversations"],"summary":"Opener","description":"The persona sends the FIRST message — call this right after creating the chat.\n\nThe one call `nudge` cannot do: it needs a chat to react to, so on an empty\none it skips. Use this instead when you want her to open — a \"say hi first\"\nbutton, or fired automatically the moment the match is made — and the human\nfinds a message already waiting.\n\nShe knows only the `user_name` and `user_gender` given at create time; she has\nno profile, photo or bio for him and will never pretend otherwise. The reply\ncomes back in the same `messages` + `delay_ms` shape as any other, and is\nsaved to the history, so the frontend renders it exactly like a normal reply.\n\nNothing is sent (`messages` empty) when `skipped` says why: \"blocked\", or\n\"already_started\" if the chat already holds a message — so this is safe to\ncall twice, it will never stack a second hello. `superseded: true` means he\ntyped first while she was writing; his own reply speaks for her.","operationId":"opener_api_conversations__conversation_id__opener_post","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{conversation_id}/nudge":{"post":{"tags":["conversations"],"summary":"Nudge","description":"The persona reaches out first — call this when the human has gone quiet.\n\nThe frontend owns the timing (idle a few minutes, next morning, days later)\nand sends no body; from the conversation's own timestamps the persona decides\nwhat fits — tease him for vanishing, wish good morning, miss him. The reply\ncomes back in the same `messages` + `delay_ms` shape as a normal reply, and\nis saved to the history, so the frontend renders it exactly like one.\n\nNothing is sent (`messages` empty) when `skipped` says why: \"blocked\",\n\"pending_reply\" (his message is being answered right now), \"too_soon\" (she\nalready pinged this chat and he has not answered — the wait grows with each\nunanswered ping: 3h, 12h, a day, then two days) or \"user_recently_pinged\"\n(another of his chats reached out in the last 30 minutes). So this is safe\nto call on a fixed schedule; the pacing is decided here. On an empty chat\nshe opens instead — same as calling `opener` — so a scheduler that only\ncalls this still gets her first text out. `superseded: true` means he typed\nwhile the nudge was being written — his own reply takes over.","operationId":"nudge_api_conversations__conversation_id__nudge_post","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{conversation_id}/gifts":{"post":{"tags":["conversations"],"summary":"Gift Purchased","description":"Tell the persona the human bought a gift — she thanks him right away.\n\nCall this AFTER the coin purchase succeeded on your side; coins never touch\nthis service. The gift is recorded and remembered permanently even when the\nthank-you is skipped (`skipped: \"blocked\"`). The response is the same\n`messages` + `delay_ms` shape as a reply, so render it with the same loop.","operationId":"gift_purchased_api_conversations__conversation_id__gifts_post","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GiftPurchaseIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{conversation_id}":{"get":{"tags":["conversations"],"summary":"Get Conversation","operationId":"get_conversation_api_conversations__conversation_id__get","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"patch":{"tags":["conversations"],"summary":"Update Conversation","description":"Move the stage by hand, block/unblock, fix the human's name or pet name, or\nre-point the caller's user reference.","operationId":"update_conversation_api_conversations__conversation_id__patch","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConversationUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{conversation_id}/details":{"get":{"tags":["conversations"],"summary":"Get Details","description":"What the persona has learned about the human in this conversation.","operationId":"get_details_api_conversations__conversation_id__details_get","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"tags":["conversations"],"summary":"Add Detail","description":"Teach the persona a fact about the human that the analyzer missed.","operationId":"add_detail_api_conversations__conversation_id__details_post","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{conversation_id}/details/{detail_id}":{"patch":{"tags":["conversations"],"summary":"Update Detail","description":"Correct a fact the persona got wrong.","operationId":"update_detail_api_conversations__conversation_id__details__detail_id__patch","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}},{"name":"detail_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetailUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["conversations"],"summary":"Delete Detail","description":"Make the persona forget something.","operationId":"delete_detail_api_conversations__conversation_id__details__detail_id__delete","parameters":[{"name":"conversation_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}},{"name":"detail_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/flags":{"get":{"tags":["flags"],"summary":"List Flags","operationId":"list_flags_api_flags_get","parameters":[{"name":"status","in":"query","required":false,"schema":{"anyOf":[{"enum":["open","reviewed"],"type":"string"},{"type":"null"}],"default":"open","title":"Status"}},{"name":"conversation_id","in":"query","required":false,"schema":{"anyOf":[{"$ref":"#/components/schemas/PydanticObjectId"},{"type":"null"}],"title":"Conversation Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/flags/{flag_id}":{"patch":{"tags":["flags"],"summary":"Update Flag","operationId":"update_flag_api_flags__flag_id__patch","parameters":[{"name":"flag_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FlagUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/settings":{"get":{"tags":["settings"],"summary":"Get Settings","operationId":"get_settings_api_settings_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"patch":{"tags":["settings"],"summary":"Update Settings","operationId":"update_settings_api_settings_patch","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SettingsIn"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/settings/options":{"get":{"tags":["settings"],"summary":"Get Options","description":"What an admin UI needs to render its dropdowns.","operationId":"get_options_api_settings_options_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/settings/analyzer-prompt/reset":{"post":{"tags":["settings"],"summary":"Reset Analyzer Prompt","description":"Put the shipped analyzer prompt back after a bad edit.","operationId":"reset_analyzer_prompt_api_settings_analyzer_prompt_reset_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/settings/platform-prompt/reset":{"post":{"tags":["settings"],"summary":"Reset Platform Prompt","description":"Put the shipped platform block back after a bad edit.","operationId":"reset_platform_prompt_api_settings_platform_prompt_reset_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/gifts":{"post":{"tags":["gifts"],"summary":"Create Gift","operationId":"create_gift_api_gifts_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GiftIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["gifts"],"summary":"List Gifts","operationId":"list_gifts_api_gifts_get","parameters":[{"name":"gender","in":"query","required":false,"schema":{"anyOf":[{"enum":["male","female"],"type":"string"},{"type":"null"}],"title":"Gender"}},{"name":"is_active","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Is Active"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/gifts/{gift_id}":{"get":{"tags":["gifts"],"summary":"Get Gift","operationId":"get_gift_api_gifts__gift_id__get","parameters":[{"name":"gift_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"tags":["gifts"],"summary":"Update Gift","operationId":"update_gift_api_gifts__gift_id__put","parameters":[{"name":"gift_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GiftIn"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["gifts"],"summary":"Delete Gift","operationId":"delete_gift_api_gifts__gift_id__delete","parameters":[{"name":"gift_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/PydanticObjectId"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/health":{"get":{"summary":"Health","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"ConversationIn":{"properties":{"profile_i